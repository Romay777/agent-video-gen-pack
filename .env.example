# Copy to .env and fill in. .env is git-ignored.

# Create a key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
OPENROUTER_TTS_VOICE=Zephyr

# Optional: default delivery style applied to every line (full sentences work best)
# OPENROUTER_TTS_INSTRUCTIONS=Warm, calm documentary narrator. Unhurried, with gentle emphasis.

# Optional: identify who is making the requests (sent as OpenRouter `user`; see docs/client-billing-research.md)
# OPENROUTER_USER=client-acme
